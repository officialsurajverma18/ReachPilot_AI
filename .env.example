FLASK_ENV=development
ENVIRONMENT=development
REQUIRE_LICENSE=false
SECRET_KEY=change-me-in-production
# Supabase/Render PostgreSQL URL. Leave unset to use local SQLite.
DATABASE_URL=
# Render: use the Supabase Postgres connection string for the existing
# licenses and usage tables. Never put the Supabase service-role key in frontend files.
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
